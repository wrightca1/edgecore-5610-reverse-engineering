		  'flush_rollback' : iptables_rollback,
		  'setcounter' : iptables_set_counters,
		  'list' : iptables_list},
	aclRuleType.ip6tables :
		{ 'prepare' : ip6tables_prepare_install,
		  'install' : ip6tables_install,
